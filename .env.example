# Copy to .env on a fresh checkout, then set local credentials.
# Task loads .env for `task run` and `task test-azure`.
# Exported environment variables take precedence over .env.

S3_ACCESS_KEY=gateway-local
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BACKEND=disk
S3_LISTEN=127.0.0.1:9000
S3_REGION=us-east-1
S3_DISK_ROOT=./data

# Azure: set S3_BACKEND=azure or run `task run -- -backend azure`.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Optional endpoint; normally derived from AZURE_STORAGE_ACCOUNT.
AZURE_STORAGE_SERVICE_URL=
# Use a SAS token instead of AZURE_STORAGE_KEY, or leave both empty
# to use DefaultAzureCredential (for example, an Azure CLI login).
AZURE_STORAGE_SAS_TOKEN=
