# Copy to .env on a fresh checkout, then set local credentials.
# Task loads .env for `task run` and `task test-azure`.
# Exported environment variables take precedence over .env.

GATEWAY_ACCESS_KEY=gateway-local
GATEWAY_SECRET_KEY=replace-with-a-long-random-secret
GATEWAY_BACKEND=disk
GATEWAY_LISTEN=127.0.0.1:9000
GATEWAY_REGION=us-east-1
GATEWAY_DISK_ROOT=./data
# Lifecycle executes only enabled bucket rules; expiration uses real UTC days.
GATEWAY_LIFECYCLE_INTERVAL=1m

# Azure: set GATEWAY_BACKEND=azure or run `task run -- -backend azure`.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Optional endpoint; normally derived from AZURE_STORAGE_ACCOUNT.
AZURE_STORAGE_SERVICE_URL=
# Use a SAS token instead of AZURE_STORAGE_KEY, or leave both empty
# to use DefaultAzureCredential (for example, an Azure CLI login).
AZURE_STORAGE_SAS_TOKEN=

# S3 / RustFS: set GATEWAY_BACKEND=s3 or run `task run -- -backend s3`.
# Keep the provider on a different port from the gateway.
# Optional S3 endpoint override; leave unset to use the AWS SDK endpoint configuration.
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9002
AWS_REGION=us-east-1
# Gateway-specific mode: path uses host/bucket/key; virtual uses bucket.host/key.
# This setting is interpreted by the gateway, not by the AWS SDK.
AWS_ENDPOINT_URL_S3_MODE=path
# Upstream credentials are independent of the gateway's GATEWAY_ACCESS_KEY/SECRET_KEY.
# Leave unset to use the AWS SDK credential chain (profiles, workload roles, etc.).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# JWT -> temporary S3 credentials (empty disables web identity).
GATEWAY_IDENTITY_CONFIG=

# SNS notifications: endpoint enables publishing to a compatible provider.
# Set GATEWAY_SNS_ENABLED=true without an endpoint to use AWS SNS.
GATEWAY_SNS_ENABLED=false
GATEWAY_SNS_ENDPOINT=
GATEWAY_SNS_REGION=us-east-1
GATEWAY_SNS_ACCESS_KEY=
GATEWAY_SNS_SECRET_KEY=
GATEWAY_SNS_SESSION_TOKEN=
